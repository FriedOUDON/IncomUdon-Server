# -----------------------------------------------------------------------------
# Relay UDP publication
# -----------------------------------------------------------------------------

# Host UDP port exposed by Docker Compose.
INCOMUDON_RELAY_PORT=50000

# -----------------------------------------------------------------------------
# Talk control
# -----------------------------------------------------------------------------

# Server-managed PTT timeout in seconds. Set 0 to disable.
INCOMUDON_TALK_MAX_SEC=0

# Set true to permit simultaneous transmitters.
INCOMUDON_MULTI_TALK=false

# Channel-wide concurrent transmitter limit when multi-talk is enabled (1..16).
INCOMUDON_MAX_ACTIVE_TALKERS=2

# -----------------------------------------------------------------------------
# Control Authentication v1 and AES-GCM v2 media gating
# -----------------------------------------------------------------------------

# off: legacy control packets only; optional: require authentication for
# channels present in the key CSV; required: reject all unauthenticated control.
INCOMUDON_CONTROL_AUTH_POLICY=off

# Keep per-channel control keys and the Relay-only cookie secret outside Git.
# In Docker Compose, the directory below is mounted at /run/incomudon-control.
INCOMUDON_CONTROL_DATA_DIR=./control
# INCOMUDON_CONTROL_KEY_FILE=/run/incomudon-control/control-keys.csv
# INCOMUDON_CONTROL_COOKIE_SECRET_FILE=/run/incomudon-control/cookie.secret

# -----------------------------------------------------------------------------
# Identity Admission v1 and Floor Interrupt v1
# -----------------------------------------------------------------------------

# off: no ticket processing; optional: accept legacy JOIN and verify presented
# tickets; required: require a valid Identity Admission before JOIN/PTT.
INCOMUDON_IDENTITY_ADMISSION_MODE=off
# INCOMUDON_IDENTITY_ISSUER=https://access.example.example
# INCOMUDON_IDENTITY_AUDIENCE=incomudon-relay-production
INCOMUDON_IDENTITY_DATA_DIR=./identity
# INCOMUDON_IDENTITY_SIGNING_KEY_FILE=/run/incomudon-identity/signing-keys.csv

# Requires identity admission and Control Authentication to both be required.
INCOMUDON_FLOOR_INTERRUPT_ENABLED=false

# -----------------------------------------------------------------------------
# Managed Service Admission v1
# -----------------------------------------------------------------------------

# off: do not process service-admission packets; enabled: accept signed grants.
INCOMUDON_SERVICE_ADMISSION_MODE=off
# INCOMUDON_SERVICE_ADMISSION_ISSUER=https://management.example.example
# INCOMUDON_SERVICE_ADMISSION_AUDIENCE=incomudon-relay-production
INCOMUDON_SERVICE_ADMISSION_DATA_DIR=./service-admission
# INCOMUDON_SERVICE_ADMISSION_SIGNING_KEY_FILE=/run/incomudon-service-admission/verification-keys.csv

# -----------------------------------------------------------------------------
# Directory UDP v3 (optional)
# -----------------------------------------------------------------------------

# Disabled by default. The default transport shares the Relay media UDP port
# and uses the authenticated IDP3 carrier; it needs no additional port mapping.
INCOMUDON_DIRECTORY_ENABLED=false
INCOMUDON_DIRECTORY_TRANSPORT=media-port
INCOMUDON_DIRECTORY_DATA_DIR=./directory-v3

# The Relay reads a pre-derived 32-byte directory_channel_key for each channel.
# Do not place raw channel credentials or password_key values in this file.
# INCOMUDON_DIRECTORY_KEY_FILE=/run/incomudon-directory-v3/directory-keys.csv
# INCOMUDON_DIRECTORY_CHANNELS_CSV=/run/incomudon-directory-v3/channels.csv
# INCOMUDON_DIRECTORY_SPEAKERS_CSV=/run/incomudon-directory-v3/speakers.csv
# INCOMUDON_DIRECTORY_PUBLISH_INTERVAL=30s
# INCOMUDON_DIRECTORY_FRESHNESS_TTL=90s

# This alternative needs an explicit Docker UDP port mapping outside the default
# compose.yaml configuration.
# INCOMUDON_DIRECTORY_TRANSPORT=dedicated-udp
# INCOMUDON_DIRECTORY_DEDICATED_LISTEN=:51000

# -----------------------------------------------------------------------------
# Management Plane v1 (optional mTLS HTTPS listener)
# -----------------------------------------------------------------------------

INCOMUDON_MANAGEMENT_ENABLED=false
# INCOMUDON_MANAGEMENT_LISTEN=127.0.0.1:8443
# The embedded listener supports only live SSE or no SSE. It does not retain
# SSE history and always advertises audit_retrieval=false.
INCOMUDON_MANAGEMENT_EVENT_DELIVERY=live
INCOMUDON_MANAGEMENT_DATA_DIR=./management
# INCOMUDON_MANAGEMENT_CERT_FILE=/run/incomudon-management/server.crt
# INCOMUDON_MANAGEMENT_KEY_FILE=/run/incomudon-management/server.key
# INCOMUDON_MANAGEMENT_CLIENT_CA_FILE=/run/incomudon-management/client-ca.crt
# INCOMUDON_MANAGEMENT_SERVICES_CSV=/run/incomudon-management/management-services.csv
# INCOMUDON_MANAGEMENT_CHANNEL_ACL_CSV=/run/incomudon-management/management-channel-acl.csv
# INCOMUDON_MANAGEMENT_GLOBAL_PERMISSIONS_CSV=/run/incomudon-management/management-global-permissions.csv
# INCOMUDON_MANAGEMENT_SIGNING_KEY_FILE=/run/incomudon-management/signing-key.csv

# -----------------------------------------------------------------------------
# Private Control Link v1 P1 event export (optional, separate mTLS listener)
# -----------------------------------------------------------------------------

# This is not the Management Plane HTTPS API. It exports live, redacted Relay
# lifecycle events to an external Management Service without retaining history.
INCOMUDON_PRIVATE_CONTROL_ENABLED=false
# INCOMUDON_PRIVATE_CONTROL_LISTEN=127.0.0.1:9443
# INCOMUDON_PRIVATE_CONTROL_CERT_FILE=/run/incomudon-private-control/server.crt
# INCOMUDON_PRIVATE_CONTROL_KEY_FILE=/run/incomudon-private-control/server.key
# INCOMUDON_PRIVATE_CONTROL_CLIENT_CA_FILE=/run/incomudon-private-control/client-ca.crt
# INCOMUDON_PRIVATE_CONTROL_SERVICES_CSV=/run/incomudon-private-control/services.csv
# INCOMUDON_PRIVATE_CONTROL_RELAY_ID=relay-production-east-1

# -----------------------------------------------------------------------------
# External Management Service Compose overlay (optional)
# -----------------------------------------------------------------------------

# `compose.management.yaml` pulls this separately built container image. Pin a
# released tag in production instead of relying on the main branch image.
INCOMUDON_MANAGEMENT_IMAGE=ghcr.io/friedoudon/incomudon-management:main
# INCOMUDON_MANAGEMENT_PCL_DATA_DIR=./management-pcl

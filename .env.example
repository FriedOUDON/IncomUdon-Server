# Host UDP port exposed by Docker Compose.
INCOMUDON_RELAY_PORT=50000

# Server-managed PTT timeout in seconds. Set 0 to disable.
INCOMUDON_TALK_MAX_SEC=0

# Set true to permit simultaneous transmitters.
INCOMUDON_MULTI_TALK=false

# Channel-wide concurrent transmitter limit when multi-talk is enabled.
INCOMUDON_MAX_ACTIVE_TALKERS=2

# Optional PSK-protected UDP directory provisioning for PWA servers.
# See directory.md for CSV format, PSK generation, and deployment details.
# Create these files outside version control and mount the directory read-only.
INCOMUDON_DIRECTORY_DATA_DIR=./directory
# INCOMUDON_DIRECTORY_CHANNELS_CSV=/run/incomudon-directory/channels.csv
# INCOMUDON_DIRECTORY_SPEAKERS_CSV=/run/incomudon-directory/speakers.csv
# INCOMUDON_DIRECTORY_UDP_TARGET=host.docker.internal:51000
# INCOMUDON_DIRECTORY_PSK_FILE=/run/incomudon-directory/directory.psk
INCOMUDON_DIRECTORY_KEY_ID=pwa-1
INCOMUDON_DIRECTORY_PUBLISH_INTERVAL=60s
INCOMUDON_DIRECTORY_TTL=120s
